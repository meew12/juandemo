// UMPI Marketplace - Prisma Schema
// Diseñado para MySQL (GoDaddy) - compatible con SQLite para desarrollo local.
// Para producción en GoDaddy: cambiar `provider = "sqlite"` a `provider = "mysql"`
// y configurar DATABASE_URL con las credenciales de MySQL de GoDaddy.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./db/custom.db"
}

// ─────────────────────────── USUARIOS ───────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  lastName       String?
  passwordHash   String?
  image          String?
  phone          String?
  zone           String?
  bio            String?
  avatarInitials String?
  role           String   @default("user") // user | admin
  plan           String   @default("basico") // basico | pro | business
  verified       Boolean  @default(false)
  banned         Boolean  @default(false)
  memberSince    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  listings       Listing[]
  reviews        Review[]
  favorites      Favorite[]
  conversations  Conversation[]      @relation("ConvParticipants")
  messages       Message[]
  subscriptions  Subscription[]
  transactions   Transaction[]
  reports        Report[]            @relation("ReporterReports")
  reportsAgainst Report[]            @relation("ReportedReports")
  boosts         Boost[]
  notifications  Notification[]
  sessions       Session[]
  accounts       Account[]
}

// ─────────────────────────── NEXTAUTH ───────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────── CATEGORÍAS ───────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  type        String   // servicio | auto | propiedad
  icon        String?
  description String?
  count       Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    Listing[]
  subcategories Subcategory[]

  @@index([type])
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  slug       String
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings   Listing[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// ─────────────────────────── PUBLICACIONES ───────────────────────────

model Listing {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  categoryType String   // servicio | auto | propiedad
  categoryId   String?
  subcategoryId String?
  price        Float
  currency     String   @default("ARS") // ARS | USD
  priceUnit    String?  // hora | dia | mes | unico | null
  location     String?
  zone         String?
  province     String?
  images       String   @default("[]") // JSON array de URLs
  thumbs       String   @default("[]") // JSON array de thumbnail URLs
  attrs        String   @default("{}") // JSON object con atributos específicos por categoría
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  views        Int      @default(0)
  contactCount Int      @default(0)
  badge        String?  // featured | hot | new | null
  featured     Boolean  @default(false)
  featuredUntil DateTime?
  boostLevel   Int      @default(0) // 0=ninguno, 1=destacado, 2=top, 3=premium destacado
  status       String   @default("active") // active | pending | paused | rejected | sold
  rejectionReason String?
  sellerId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory? @relation(fields: [subcategoryId], references: [id])
  reviews      Review[]
  favorites    Favorite[]
  conversations Conversation[]
  reports      Report[]
  boosts       Boost[]

  @@index([categoryType])
  @@index([sellerId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

// ─────────────────────────── RESEÑAS ───────────────────────────

model Review {
  id         String   @id @default(cuid())
  listingId  String
  userId     String
  rating     Int      // 1-5
  comment    String
  status     String   @default("active") // active | hidden | deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([listingId])
  @@index([userId])
}

// ─────────────────────────── FAVORITOS ───────────────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

// ─────────────────────────── MENSAJERÍA ───────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  listingId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants User[]  @relation("ConvParticipants")
  messages    Message[]

  @@index([listingId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// ─────────────────────────── SUSCRIPCIONES ───────────────────────────

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  plan          String   // basico | pro | business
  status        String   @default("active") // active | canceled | past_due | pending
  startDate     DateTime @default(now())
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  mercadopagoId String?  // ID de la suscripción en MP
  mercadopagoPreapprovalId String?
  amount        Float    // monto mensual en ARS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId])
  @@index([status])
}

// ─────────────────────────── BOOSTS / DESTACADOS ───────────────────────────

model Boost {
  id            String   @id @default(cuid())
  listingId     String
  userId        String
  type          String   // destacado | top | premium_destacado
  durationDays  Int      // 7, 15, 30, etc.
  amount        Float
  status        String   @default("pending") // pending | active | expired | canceled
  startDate     DateTime?
  endDate       DateTime?
  mercadopagoPaymentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([listingId])
  @@index([status])
}

// ─────────────────────────── TRANSACCIONES ───────────────────────────

model Transaction {
  id             String   @id @default(cuid())
  txId           String   @unique // TXN-XXXX
  userId         String
  subscriptionId String?
  boostId        String?
  concept        String   // Suscripción Pro | Boost Destacado | etc.
  method         String   // mercadopago | tarjeta | transferencia
  amount         Float
  currency       String   @default("ARS")
  status         String   @default("pending") // pending | approved | rejected | refunded | canceled
  mercadopagoPaymentId String?
  mercadopagoPreferenceId String?
  invoiceType    String?  // A | B | C (Factura)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  boost          Boost?       @relation(fields: [boostId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────── REPORTES / MODERACIÓN ───────────────────────────

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reportedUserId String?
  listingId   String?
  reason      String   // spam | fraude | contenido inapropiado | estafa | otro
  description String?
  status      String   @default("open") // open | reviewing | resolved | dismissed
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportedReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing     Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([listingId])
}

// ─────────────────────────── NOTIFICACIONES ───────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // message | review | boost | subscription | system | favorite
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

// ─────────────────────────── PLANES PREMIUM ───────────────────────────

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique // basico | pro | business
  name        String
  price       Float
  currency    String   @default("ARS")
  interval    String   @default("month")
  description String?
  features    String   @default("[]") // JSON array de strings
  maxListings Int      @default(1)
  maxFeatured Int      @default(0)
  badgeVerified Boolean @default(false)
  top10Access Boolean  @default(false)
  multiUser   Int      @default(1)
  apiAccess   Boolean  @default(false)
  prioritySupport Boolean @default(false)
  monthlyReport Boolean @default(false)
  invoiceType String?  // A | B | null
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── CONFIGURACIÓN SITIO ───────────────────────────

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ─────────────────────────── LOGS DE AUDITORÍA ───────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // user_ban | listing_approve | listing_reject | boost_grant | etc.
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
